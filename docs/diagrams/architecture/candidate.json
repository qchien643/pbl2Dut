  "cards": [
    {"dot": "cyan", "title": "Khởi tạo và quyền sở hữu", "items": [
      "main tạo ApplicationData, CatalogService, ScreeningService, TicketService rồi MainWindow.",
      "ApplicationData sở hữu năm repository; các service và cửa sổ chỉ giữ tham chiếu.",
      "Sơ đồ nhóm ba service và năm kho; các mũi tên biểu diễn lời gọi, không phải mọi quan hệ sở hữu."
    ]},
    {"dot": "amber", "title": "Bán vé chưa đồng nghĩa lưu file", "items": [
      "TicketService chỉ thêm vé sau khi xác nhận tiền, ghế còn trống và suất chưa bắt đầu.",
      "Repository cập nhật RAM và đánh dấu dirty. MainWindow gọi save khi người dùng xác nhận lưu và thoát.",
      "ApplicationData kiểm tra toàn vẹn, gọi codec ghi file tạm rồi thay bộ file; lỗi lưu giữ cửa sổ mở."
    ]},
    {"dot": "emerald", "title": "Giới hạn cần nhớ khi vấn đáp", "items": [
      "Ứng dụng chạy offline, một tiến trình; không có SQL server hay API mạng.",
      "Codec thực hiện I/O bản ghi; ApplicationData quản lý file tạm và bản sao lưu. Không tuyên bố ACID.",
      "Nguồn là bản chụp cục bộ ngày 26/10/2026, chưa đẩy GitHub; nút điều khiển sơ đồ dùng tiếng Anh."
    ]}
  ]
