  "cards": [
    {"dot": "cyan", "title": "Đọc đúng phạm vi", "items": [
      "Đây là lát cắt OOP của tầng repository, không phải sơ đồ mọi lớp và mọi thành viên.",
      "FilmRepository đại diện cho bốn lớp kế thừa: FilmRepository, AuditoriumRepository, SeatRepository, ScreeningRepository.",
      "Repository<T> biểu diễn mẫu; Repository<Film> và Repository<Ticket> là hai kiểu cụ thể khác nhau."
    ]},
    {"dot": "emerald", "title": "Ba quan hệ khác nhau", "items": [
      "Kế thừa: FilmRepository nhận giao diện thao tác của Repository<Film>.",
      "Composition: TicketRepository chứa một Repository<Ticket>; chỉ chuyển tiếp các hàm được phép.",
      "Association: TicketService giữ TicketRepository&, không sở hữu hay hủy kho."
    ]},
    {"dot": "amber", "title": "Bộ nhớ và các phần đã lược", "items": [
      "LinkedList sở hữu entity; HashTable chỉ lưu con trỏ đến entity trong danh sách.",
      "Repository cấm copy và move để tránh sai liên kết giữa danh sách với chỉ mục.",
      "ApplicationData còn sở hữu ba kho khác; TicketService còn tham chiếu bốn kho khác. Các entity liên kết qua ID: xem ERD.",
      "Nguồn là bản chụp cục bộ; điều khiển trình xem bằng tiếng Anh."
    ]}
  ]
}
