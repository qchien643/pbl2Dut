  "cards": [
    {"dot": "cyan", "title": "Đây là mô hình dữ liệu, không phải SQL", "items": [
      "Tên cột đúng header của năm file TXT; int64 và string là kiểu dữ liệu ứng dụng, không phải DDL.",
      "PK/FK là ràng buộc được C++ kiểm tra. Mỗi bản ghi con tham chiếu đúng một bản ghi cha.",
      "Một phim/phòng có thể chưa có suất; một suất/ghế có thể chưa có vé. Phòng hợp lệ phải có đủ ma trận ghế."
    ]},
    {"dot": "amber", "title": "Khóa ghép và toàn vẹn", "items": [
      "Seat duy nhất theo (auditorium_id, row_number, seat_number).",
      "Ticket duy nhất theo (screening_id, seat_id), không phải mỗi seat_id chỉ có một vé trong mọi suất.",
      "Ghế và suất của vé phải thuộc cùng phòng. Thời điểm bán phải trước giờ chiếu."
    ]},
    {"dot": "emerald", "title": "Câu hỏi thường gặp", "items": [
      "Seat không lưu isSold: trạng thái đã bán phụ thuộc Ticket của từng suất.",
      "unit_price giữ giá tại lúc bán; thống kê theo sold_at, không theo start_time.",
      "Đường nét đứt là quan hệ non-identifying: FK không nằm trong PK; không có nghĩa FK được để trống.",
      "Nguồn là bản chụp cục bộ ngày 26/10/2026; điều khiển trình xem dùng tiếng Anh."
    ]}
  ]
